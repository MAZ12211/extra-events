import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.ui.freeplay.FreeplayState;
import flixel.text.FlxText;

class EEAdjustAlbumFontSize extends Module {
    public function new(){
        super("extra-events-adjustAlbumFontSize", 16, {
            state: FreeplayState
        });
    }

    function onCapsuleSelected(e) {
        super.onCapsuleSelected(e);
        switch (e.capsule?.freeplayData?.data?.id) {
            case "ee-darnell-mrk-mix", "ee-south-mrk-mix":
                FlxG.state.subState?.ostName?.size = 36;
            case "ee-monster":
                FlxG.state.subState?.ostName?.size = 16;
            default:
                FlxG.state.subState?.ostName?.size = 48;
        }
    }
}